{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/readyz",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 2
  },
  "services": [
    {
      "name": "forgeguard-app",
      "port": 8000,
      "protocol": "HTTP",
      "env": {
        "DEMO_MODE": "0",
        "LOG_LEVEL": "info",
        "REDIS_URL": "redis://redis:6379/0"
      }
    }
  ]
}
